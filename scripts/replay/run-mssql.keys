# T5.2: run a statement and read a cell out of the grid. The container
# `scripts/db-up.sh` starts has to be up. Run it with a state directory of
# its own — scripts/qa/run-queries.sh does — or the pad starts with whatever
# the last run typed into it.

key c
wait busy
expect ● local-mssql

key Tab
type select id, name, country from bench.customers order by id
key Ctrl-R
wait busy

expect Zoë Bauer
expect ╭ Results ·
frame run-mssql

# A range of the grid, copied: out of the pad (Tab is two spaces there),
# `v` and two moves make it two rows by two columns, and `y` ends it.
key Shift-Tab
key Shift-Tab
key v
key j
key l
expect · 2×2 selected
key y
expect copied 4 cells
expect-not selected
key Ctrl-Q
