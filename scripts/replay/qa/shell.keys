# The shell at whatever --size scripts/qa.sh runs this at: every pane title
# whole, the footer saying where the connection is, and the help overlay
# whole. Each title is expected with the space and the first border dash
# after it, so a title cut off at the pane's right edge fails here.

expect ╭ Objects ─
expect ╭ Scratch ─
expect ╭ Results ─
expect ○ disconnected

key ?
expect ╭ Help · Objects ─
expect Tab        next pane
expect Ctrl-Q     quit
key Esc
expect-not ╭ Help

# The Scratch pad's keys are more than a 60x15 screen holds, so the overlay
# scrolls: the last of them is one PageDown away at every size, and a list
# clipped instead of scrolled fails here.
key Tab
key ?
expect ╭ Help · Scratch
expect Ctrl-R        run the statement
key PageDown
expect Ctrl-Q        quit
key Esc
key Shift-Tab
expect-not ╭ Help

# Round the three panes and back the other way; the layout survives either.
# Shift-Tab is the way round that never types, Tab being the pad's own key.
key Shift-Tab
key Shift-Tab
key Shift-Tab
key Tab
key Shift-Tab
expect ╭ Objects ─
expect ╭ Scratch ─
expect ╭ Results ─
expect ○ disconnected
# Nothing above typed into the pad — the overlay's scroll keys least of all.
expect-not [modified]
