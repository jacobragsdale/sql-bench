key Shift-Tab

# 11: every type bench.all_types holds, read against docs/TYPES.md. Two
# frames, because two dozen columns do not fit across one.
key Ctrl-A
key Ctrl-K
type select * from bench.all_types
key Ctrl-R
wait busy
key Shift-Tab
key Shift-Tab
key 0
frame types-left
key $
frame types-right

key Ctrl-Q
