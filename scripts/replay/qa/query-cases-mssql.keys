# T5.4 cases 1, 2, 4, 11 and 12 on SQL Server: unicode in the SQL and in the
# rows, three hundred columns, NULL-only rows, every type in the grid, and a
# CJK name that must not lean the column after it.
#
# One connection in the config, so this is tab 1 whichever backend it is;
# scripts/qa/query-workflow.sh runs it at 400x24 and measures the frames.

key c
wait busy
expect ●

key Tab

# 1: unicode in the statement and in the answer.
type select name, country from bench.customers where name like N'%ë%'
key Ctrl-R
wait busy
expect Zoë Bauer
frame unicode

# 12: the row with 李雷 in it. The frame is where the alignment is measured:
# the runner compares the column the country starts at on every row.
key Ctrl-A
key Ctrl-K
type select name, country, email from bench.customers where id <= 5 order by id
key Ctrl-R
wait busy
expect 李
frame cjk

# 4: a row of nothing but NULLs says so rather than leaving the columns blank.
key Ctrl-A
key Ctrl-K
type select null as a, null as b
key Ctrl-R
wait busy
expect NULL  NULL
frame nulls

# 2: three hundred columns. $ walks the cell cursor to the last of them, and
# the grid scrolls the window across to it.
