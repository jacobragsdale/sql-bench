# T7.1's key-to-frame case: a full result set on screen and a hundred keys
# walked over it, so the trace's `frame` lines are a p95 worth the name.
# `scripts/perf.sh` runs it at --max-rows 10000 and again at 100000; every
# key is one frame, and the grid is the only thing on screen that grows.

key c
wait busy
expect ●

key Tab
type select * from bench.events
key Ctrl-R
wait busy

key Shift-Tab
key Shift-Tab
key g
key PageDown
key j
key G
key g
