# T6.1: the object tree against Oracle, where every catalog name is upper
# case. The container `scripts/db-up.sh` starts has to be up. Run it with a
# state directory of its own — scripts/qa/run-queries.sh does — or the pad
# starts with whatever the last run typed into it.

key 2
key c
wait busy
expect ● local-oracle
# The schema the connection is in is listed first and open.
expect ▾ BENCH

key j
key l
wait busy
expect CUSTOMERS

# i: the columns of the table the cursor is on, as a grid.
key j
key j
key j
key j
key i
wait busy
expect BENCH.CUSTOMERS columns
expect EMAIL
expect NVARCHAR2(100)

# Enter: a hundred rows of it in the pad, spelled the way Oracle spells a
# limit, on a line of its own.
key Enter
expect select * from BENCH.CUSTOMERS fetch first 100 rows only
key Shift-Tab

# The views, so the filter has something of each kind to keep. Up from the
# table to its kind, close it, and the next row is the views: counting from
# the last schema breaks as soon as the server has one more.
key h
key h
key j
key l
wait busy
expect V_RECENT_ORDERS

# /cust keeps what matches and the branches above it, and nothing else.
key /
wait busy
type cust
expect ╭ Objects /cust ─
expect CUSTOMERS
expect V_CUSTOMER_TOTALS
expect-not ▸ Procedures
key Esc
expect ▸ Procedures

# s: the text that made a procedure, in the results pane with line numbers.
# The filter finds it under a branch nobody opened, and Enter keeps it.
key /
type customer_orders
key Enter
key s
wait busy
expect Source · BENCH.CUSTOMER_ORDERS
expect PROCEDURE customer_orders
frame objects-oracle

# Ctrl-P: every object of the connection, found as its name is typed, the
# lower-case query against Oracle's upper-case names, and Enter opens the
# tree on it with its source in the results pane.
key Ctrl-P
expect ╭ Find · 
type order_pk
expect BENCH.ORDER_PKG
expect package
key Enter
expect-not ╭ Find
wait busy
expect Source · BENCH.ORDER_PKG
expect PACKAGE order_pkg
frame objects-oracle-found
key Ctrl-Q
